<%%= form_tag verify_path do %>
  <%% if @error %>
    <div class="error"><%%= @error %></div>
  <%% end %>

  <p>A code was sent to <strong><%%= @phone %></strong></p>

  <%%= label_tag :code, "Verification code" %>
  <%%= text_field_tag :code, nil, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9]{6}", required: true %>

  <%%= submit_tag "Verify" %>
<%% end %>
