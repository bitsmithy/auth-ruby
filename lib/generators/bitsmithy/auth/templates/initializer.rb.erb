Bitsmithy::Auth.configure do |config|
  config.envelope_key = ENV.fetch("BITSMITHY_AUTH_ENVELOPE_KEY")
  config.magic_link_sender = ENV.fetch("AUTH_EMAIL_FROM")
  config.magic_link_redirect_uri = ENV.fetch("AUTH_EMAIL_REDIRECT_URI")

  config.google_client_id = ENV.fetch("GOOGLE_CLIENT_ID")
  config.google_client_secret = ENV.fetch("GOOGLE_CLIENT_SECRET")
  config.google_redirect_uri = ENV.fetch("GOOGLE_REDIRECT_URI")

  config.apple_client_id = ENV.fetch("APPLE_CLIENT_ID")
  config.apple_team_id = ENV.fetch("APPLE_TEAM_ID")
  config.apple_key_id = ENV.fetch("APPLE_KEY_ID")
  config.apple_private_key = ENV.fetch("APPLE_PRIVATE_KEY")
  config.apple_redirect_uri = ENV.fetch("APPLE_REDIRECT_URI")

  config.passkey_origin = ENV.fetch("PASSKEY_ORIGIN")
  config.passkey_relying_party_id = ENV.fetch("PASSKEY_RELYING_PARTY_ID")
  config.passkey_relying_party_name = ENV.fetch("PASSKEY_RELYING_PARTY_NAME")

  # Supply application-owned callbacks before calling config.validate!:
  # config.allow_email_request
  # config.claim_magic_link
  # config.on_authenticated
  # config.passkey_registration_context
  # config.store_passkey_credential
  # config.find_passkey_credential
  # config.update_passkey_credential
end
